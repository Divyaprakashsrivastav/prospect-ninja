{
  "name": "linkedin-prospecting-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:up": "node scripts/start-postgres.mjs",
    "db:migrate": "node scripts/run-with-env.js npx prisma migrate dev",
    "db:deploy": "node scripts/run-with-env.js npx prisma migrate deploy",
    "db:push": "node scripts/run-with-env.js npx prisma db push",
    "job:discover": "tsx src/jobs/runDiscover.ts",
    "test:campaigns": "node scripts/run-with-env.js npx tsx scripts/test-campaigns.ts",
    "test:discovery": "node scripts/run-with-env.js npx tsx scripts/test-discovery.ts",
    "test:messages": "node scripts/run-with-env.js npx tsx scripts/test-messages.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.55.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
