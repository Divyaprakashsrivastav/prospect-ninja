# Prisma Client (app). Production/Vercel: Transaction pooler port 6543 + pgbouncer=true.
# Local networks that block 6543: use Session pooler port 5432 (same host/user as DIRECT_URL).
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma migrate, introspect, and interactive transactions. Session pooler or direct DB (port 5432), not 6543.
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Local Postgres alternative (must set both):
# DATABASE_URL="postgresql://outreach:outreach@localhost:5432/outreach?schema=public"
# DIRECT_URL="postgresql://outreach:outreach@localhost:5432/outreach?schema=public"
AUTH_SECRET="generate-a-long-random-string"
# Local only. On Vercel, set AUTH_URL to the deployment origin (never localhost).
AUTH_URL="http://localhost:3000"
# Production (Vercel): AUTH_URL="https://prospect-ninja-pgbf.vercel.app"
AUTH_TRUST_HOST="true"
# Server-side only. Leave empty to use DemoAIProvider (labelled DEMO OUTPUT).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# auto = OpenAI when OPENAI_API_KEY is set, otherwise demo. Force with demo or openai.
AI_PROVIDER="auto"
CRON_SECRET="generate-a-long-random-string"
# Prospect discovery. Leave empty to use the demo provider (labelled DEMO DATA).
ROCKETREACH_API_KEY=""
# legacy = /person/search (Essentials, Pro, Ultimate plans); universal = Universal Credits plans.
ROCKETREACH_API_MODE="legacy"
# LinkedIn sending through Unipile API v2 (per-user Hosted Auth). Leave empty to keep demo sends.
# Hosted Auth redirects back to AUTH_URL (no tunnel needed for linking accounts).
UNIPILE_API_KEY=""
# Webhook endpoint secret from the Unipile dashboard (Webhooks > your endpoint). Verifies the unipile-signature header.
UNIPILE_WEBHOOK_SECRET=""
# Set to "false" to accept Unipile webhooks without checking the signature (default: check it).
UNIPILE_WEBHOOK_VERIFY="true"
HEYREACH_API_KEY=""
HEYREACH_API_BASE_URL=""
