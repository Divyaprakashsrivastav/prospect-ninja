# Prisma Client (app). For Supabase, use the Transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma migrate, introspect, and interactive transactions. Session pooler or direct DB (port 5432), not 6543.
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Local Postgres alternative (must set both):
# DATABASE_URL="postgresql://outreach:outreach@localhost:5432/outreach?schema=public"
# DIRECT_URL="postgresql://outreach:outreach@localhost:5432/outreach?schema=public"
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"
# Production (Vercel): AUTH_URL="https://YOUR-PROJECT.vercel.app"
AUTH_TRUST_HOST="true"
# Server-side only. Leave empty to use DemoAIProvider (labelled DEMO OUTPUT).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# auto = OpenAI when OPENAI_API_KEY is set, otherwise demo. Force with demo or openai.
AI_PROVIDER="auto"
CRON_SECRET="generate-a-long-random-string"
HEYREACH_API_KEY=""
HEYREACH_API_BASE_URL=""
