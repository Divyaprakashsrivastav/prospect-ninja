generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaigns          Campaign[]
  connections        IntegrationConnection[]
  prospects          Prospect[]
  leads              Lead[]
  leadOutreaches     LeadOutreach[]
  leadOutreachEvents LeadOutreachEvent[]
  auditEvents        MessageAuditEvent[]
}

model Campaign {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  description        String   @default("")
  icp                Json
  isActive           Boolean  @default(true)
  dailyDiscoverLimit Int      @default(15)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  prospects     Prospect[]
  discoveryRuns DiscoveryRun[]
  messages      OutreachMessage[]

  @@index([userId])
}

model IntegrationConnection {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  status            String
  /// Account id at the external provider (e.g. Unipile account_id).
  externalAccountId String?   @unique
  displayName       String?
  lastError         String?
  connectedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, provider])
}

model Prospect {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  provider     String
  externalId   String
  linkedinUrl  String
  fullName     String
  firstName    String   @default("")
  lastName     String   @default("")
  headline     String?
  jobTitle     String?
  companyName  String?
  companySize  String?
  location     String?
  industry     String?
  summary      String?
  /// LinkedIn member id resolved through Unipile, cached after the first lookup.
  linkedinProviderId String?
  matchScore   Int      @default(0)
  matchReasons Json
  isDemo       Boolean  @default(true)
  rawProfile   Json
  discoveredAt DateTime @default(now())

  messages OutreachMessage[]

  @@unique([userId, linkedinUrl])
  @@unique([userId, provider, externalId])
  @@index([campaignId])
  @@index([userId])
}

model DiscoveryRun {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  runDate         DateTime @db.Date
  discoveredCount Int      @default(0)
  status          String   @default("running")
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([campaignId, runDate])
}

model OutreachMessage {
  id                      String    @id @default(cuid())
  prospectId              String    @unique
  prospect                Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  campaignId              String
  campaign                Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status                  String
  body                    String
  originalBody            String?
  personalizationReason   String?
  personalizationEvidence Json?
  aiProvider              String?
  aiModel                 String?
  generationStatus        String    @default("pending")
  confidence              Float?
  approvedAt              DateTime?
  approvedBodyHash        String?
  sentAt                  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  auditEvents MessageAuditEvent[]

  @@index([campaignId])
  @@index([status])
}

model Lead {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  jobTitle     String   @default("")
  company      String   @default("")
  email        String?
  phone        String?
  linkedinUrl  String?
  website      String?
  industry     String   @default("")
  location     String   @default("")
  companySize  String   @default("")
  source       String   @default("manual")
  status       String   @default("new")
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, industry])
  @@index([userId, company])
  @@index([userId, createdAt])
  @@index([userId, email])
  @@index([userId, linkedinUrl])

  outreaches LeadOutreach[]
}

/// AI outreach drafts for CRM leads (separate from campaign Prospect messages).
/// One active record per lead + message type. History lives in LeadOutreachEvent.
model LeadOutreach {
  id                      String    @id @default(cuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId                  String
  lead                    Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messageType             String
  status                  String    @default("draft")
  body                    String
  originalBody            String?
  campaignContext         String    @default("")
  personalizationReason   String?
  personalizationEvidence Json?
  aiProvider              String?
  aiModel                 String?
  generationStatus        String    @default("pending")
  confidence              Float?
  approvedAt              DateTime?
  approvedBodyHash        String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  events LeadOutreachEvent[]

  @@unique([leadId, messageType])
  @@index([userId])
  @@index([leadId])
  @@index([userId, status])
}

model LeadOutreachEvent {
  id           String       @id @default(cuid())
  outreachId   String
  outreach     LeadOutreach @relation(fields: [outreachId], references: [id], onDelete: Cascade)
  actorUserId  String
  actor        User         @relation(fields: [actorUserId], references: [id])
  action       String
  bodySnapshot String
  metadata     Json?
  createdAt    DateTime     @default(now())

  @@index([outreachId])
  @@index([actorUserId])
}

model MessageAuditEvent {
  id           String          @id @default(cuid())
  messageId    String
  message      OutreachMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  actorUserId  String
  actor        User            @relation(fields: [actorUserId], references: [id])
  action       String
  bodySnapshot String
  metadata     Json?
  createdAt    DateTime        @default(now())

  @@index([messageId])
  @@index([actorUserId])
}

/// Every inbound webhook, stored as received (verified or not) for audit and replay.
/// No foreign keys: events must survive user/prospect deletion.
model WebhookEvent {
  id                String   @id @default(cuid())
  provider          String
  /// `event` field from the payload (e.g. "new_relation"), when present.
  event             String?
  /// Provider account the event belongs to (Unipile account_id).
  externalAccountId String?
  /// True when the shared-secret header matched.
  verified          Boolean
  /// Parsed JSON body; null when the body was not valid JSON.
  payload           Json?
  /// Body exactly as received (truncated past the size cap).
  rawBody           String
  /// Request headers, minus the secret and cookies.
  headers           Json
  /// Best-effort matches, resolved at receipt time.
  userId            String?
  prospectId        String?
  receivedAt        DateTime @default(now())

  @@index([provider, event])
  @@index([externalAccountId])
  @@index([userId])
  @@index([prospectId])
}
